\gridPutMusic "bass" 1 \relative c {
  \repeat unfold 4 {
    \repeat unfold 2 { b8 b f'4 } |
  }
}

\gridPutMusic "bass" 2 \relative c, {
  \tempo 4 = 86 \time 4/4
  g4 a8 g e4 g8 a |
  g4 g8 a g4 g8 gis |
  g4 a8 g e4 e'8 b |
  bes4 bes8 bes f4 ges |
}

\gridPutMusic "bass" 3 \relative c, {
  \Tempo \time 4/4
  g8 a g4 e e' |
  b4 b b b |
  bes4 bes bes bes |
  f4 f ges ges |
}
