\gridPutMusic "bass" 1 \relative c, {
  f4 c'4 b4 aes4 |
  bes4 g4 aes4 ges4 |
  f4 c'4 b4 aes4 |
  bes4 g4 aes2 |
  f4 c'4 b4 aes4 |
  bes4 g4 aes4 ges4 |
  f4 c'4 b4 aes4 |
  f'4 e4 ees4 des4 |
}

\gridPutMusic "bass" 2 \relative c {
%{
  c4 des4 c4 bes4 |
  c4 b aes4 ges4 |
  g4 des'4 c4 ges4 |
  f4 aes4 g4 ges4 |
%}
  c8 f, r c'[ f,] r c' f, |
  r8 b f r b4 f4 |
  des'8 f, r des'[ ges,] r c f, |
  r8 aes4. g4 ges4 |
}
